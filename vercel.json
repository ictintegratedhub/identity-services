{
  "version": 2,
  "public": true,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/identity/login.html",
      "dest": "/identity/login.html"
    },
    {
      "src": "/identity/nin.html",
      "dest": "/identity/nin.html"
    },
    {
      "src": "/identity/bvn.html",
      "dest": "/identity/bvn.html"
    },
    {
      "src": "/identity/index.html",
      "dest": "/identity/index.html"
    },
    {
      "src": "/identity/login",
      "dest": "/identity/login.html"
    },
    {
      "src": "/identity/nin",
      "dest": "/identity/nin.html"
    },
    {
      "src": "/identity/bvn",
      "dest": "/identity/bvn.html"
    },
    {
      "src": "/identity",
      "dest": "/identity/index.html"
    },
    {
      "src": "/",
      "dest": "/identity/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}