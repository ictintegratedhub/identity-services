{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/identity",
      "dest": "/identity/index.html"
    },
    {
      "src": "/identity/nin",
      "dest": "/identity/nin.html"
    },
    {
      "src": "/identity/bvn",
      "dest": "/identity/bvn.html"
    },
    {
      "src": "/identity/login",
      "dest": "/identity/login.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}