{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/identity/login",
      "destination": "/identity/login.html"
    },
    {
      "source": "/identity/nin",
      "destination": "/identity/nin.html"
    },
    {
      "source": "/identity/bvn",
      "destination": "/identity/bvn.html"
    },
    {
      "source": "/identity",
      "destination": "/identity/index.html"
    },
    {
      "source": "/",
      "destination": "/identity/index.html"
    }
  ]
}